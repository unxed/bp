+function InMethodOfGeneric(El, aType: TPasElement): boolean;
+// ObjFPC: inside a method implementation of a generic, its bare name means the generic itself
+var P: TPasElement; Scope: TPasProcedureScope;
+begin
+  P := El;
+  while P <> nil do
+    begin
+    if (P is TPasProcedure) and (P.CustomData is TPasProcedureScope) then
+      begin
+      Scope := TPasProcedureScope(P.CustomData);
+      if (Scope.ClassRecScope <> nil) and (Scope.ClassRecScope.Element = aType) then exit(true);
+      if (Scope.DeclarationProc <> nil) and Scope.DeclarationProc.HasParent(aType) then exit(true);
+      end;
+    P := P.Parent;
+    end;
+  Result := false;
+end;
