#!/usr/bin/env bash
# bp: the build command of Better Pascal (safe/SPEC.md §16). It checks the program with bpvet in the typed and strict
# mode and compiles it with fpc only when the check passes: nothing unsafe is built unless the code declares it
# (// UNSAFE:, // borrow:, // root:).
# usage: tools/bp build [--release] [fpc options] FILE.pas
#   Checked: FILE and the other sources of its directory. The fpc options are passed on; -Fu, -Fi, -d and -Fa are also
#   given to bpvet; safe/, ext/ and the BP unit are on the unit path. A debug build adds -Cr -Co (SPEC §6).
#   Caches (BP_CACHE, default ~/.cache/bp): bpvet by the hash of its sources, the RTL stubs by the hash of the checked
#   sources and the fpc version.
set -eu
[ "${1:-}" = build ] || { sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 2; }
shift
root=$(cd "$(dirname "$0")/.." && pwd)
cache=${BP_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/bp}
fpc=${FPC:-fpc}
lib=(-Fu"$root" -Fu"$root/safe" -Fu"$root/ext" -Fi"$root/safe" -Fi"$root/ext")
file= checks=(-Cr -Co) opts=() vet=() dirs=("$root/safe" "$root/ext")
for a in "$@"; do
  case "$a" in
    --release) checks=() ;;
    -Fu*|-Fi*) opts+=("$a"); vet+=("$a"); dirs+=("${a:3}") ;;
    -d*|-Fa*) opts+=("$a"); vet+=("$a") ;;
    -*) opts+=("$a") ;;
    *) file=$a ;;
  esac
done
[ -n "$file" ] || { echo "bp: no source file" >&2; exit 2; }
src=$(dirname "$file")
mkdir -p "$cache"

h=$(cat "$root"/tools/bpvet/*.pas "$root"/tools/bpvet/build.sh "$root"/tools/bpvet/resolver/* | sha256sum | cut -c1-16)
bpvet=$cache/bpvet-$h
if [ ! -x "$bpvet" ]; then
  "$root/tools/bpvet/build.sh" "$bpvet.tmp" > "$cache/bpvet-build.log" 2>&1 || { cat "$cache/bpvet-build.log"; exit 1; }
  mv "$bpvet.tmp" "$bpvet"
fi

h=$( { "$fpc" -iV; cat "$src"/*.pas; for d in "${dirs[@]}"; do cat "$d"/*.pas "$d"/*.pp "$d"/*.inc 2>/dev/null || true
  done; } | sha256sum | cut -c1-16)
stubs=$cache/stubs-$h
if [ ! -d "$stubs" ]; then
  rm -rf "$stubs.tmp"
  python3 "$root/tools/bpvet/resolver/genstubs.py" "$stubs.tmp" "$src" "${dirs[@]}" > /dev/null
  mv "$stubs.tmp" "$stubs"
fi

t0=$(date +%s%N)
"$bpvet" --strict --typed --rtl "$stubs" "${lib[@]}" "${vet[@]}" "$src" || { echo "bp: the check failed: nothing built" >&2
  exit 1; }
echo "bp: checked in $(( ($(date +%s%N) - t0) / 1000000 )) ms"
exec "$fpc" "${checks[@]}" "${lib[@]}" "${opts[@]}" "$file"
